# Copy to .env for local development. Never commit real values.
# Every variable is validated at startup by src/config/env.ts: the server
# refuses to start with a clear message if anything is missing or malformed.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
# The defaults are the React.js-Template dev and preview servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Signs access tokens (HS256). At least 32 random characters.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Seed placeholder users (demo@example.com / password123) on startup.
# Defaults to true outside production. Never enable it in production.
SEED_DEMO_DATA=

# Swagger UI at /api/docs. Defaults to true outside production.
API_DOCS_ENABLED=
